# Copy this file to .env and fill in real values. Never commit .env.

# Local dev: sqlite file. Production: swap prisma/schema.prisma's
# datasource provider to "postgresql" and put a real connection string here
# (Railway / Neon / Supabase / Vercel Postgres all work).
DATABASE_URL="file:./dev.db"

# The one V1 admin account.
ADMIN_USERNAME=
# Base64-encoded Argon2id hash of the admin password — never the plaintext
# password. Base64 is required here, not cosmetic: Next.js's .env loader
# does shell-style $VAR expansion, which silently mangles a raw Argon2 hash
# (they're full of literal $ characters, e.g. $argon2id$v=19$...).
# Generate both with: npm run admin:create-user
ADMIN_PASSWORD_HASH_B64=

# Random 32+ byte secret used to encrypt the admin session cookie.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Public Calendly scheduling link for "Review this with MODUS" (Diagnostic
# result page + personalized pricing hero). Empty = the booking widget
# hides itself rather than rendering broken; the callback-request form
# still works either way. e.g. https://calendly.com/your-slug/intro-call
NEXT_PUBLIC_CALENDLY_URL=
